# Generated by saas-core factory
# Core
# Public service name shown in the UI
NEXT_PUBLIC_SERVICE_NAME=
# Short tagline shown on the landing page
NEXT_PUBLIC_SERVICE_TAGLINE=
# Auth.js v5 session signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=
# Canonical URL of this app (e.g. https://your-app.vercel.app)
AUTH_URL=
# Supabase pooled connection string (Transaction mode, port 6543)
DATABASE_URL=
# Supabase direct connection string (Session mode, port 5432)
DIRECT_URL=

# auth.clerk: Clerk-based auth, sessions, and identity flows
# Clerk publishable key (pk_test_... or pk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (sk_test_... or sk_live_...)
CLERK_SECRET_KEY=
# Sign-in route (default: /sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Sign-up route (default: /sign-up)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Redirect after sign-in (default: /dashboard)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
# Redirect after sign-up (default: /dashboard)
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=

# db.postgres.prisma: PostgreSQL via Prisma ORM with Supabase connection pooling
# Supabase pooled connection (Transaction mode, port 6543) — already in base
DATABASE_URL=
# Supabase direct connection (Session mode, port 5432) — already in base
DIRECT_URL=
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous/public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# ai.core: OpenAI-backed AI action layer for product-specific intelligence
# OpenAI API key (sk-...)
OPENAI_API_KEY=
# Model to use (default: gpt-4o-mini)
OPENAI_MODEL=

# security.analytics: Usage analytics and security event aggregation
# PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# mcp.rest: REST-based MCP (Model Context Protocol) endpoint for agent integrations
# Secret for verifying inbound MCP requests (generate with: openssl rand -hex 32)
MCP_API_SECRET=

